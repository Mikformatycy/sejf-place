# Skopiuj do .env.local (nie trafia do gita) i wpisz klucz z https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=
# Opcjonalnie inny darmowy model (sprawdzenie: npm run gemini:smoke -- nazwa-modelu)
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.5-flash
# Zapasowy model, gdy główny jest przeciążony
EXPO_PUBLIC_GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
